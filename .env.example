# =================================================================
# SentinelScan Environment Configuration Template
# COPY this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with live secrets to GitHub!
# =================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Atlas Connection String
# Obtain this from MongoDB Atlas Dashboard -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sentinelscan?retryWrites=true&w=majority

# JWT (JSON Web Token) Security Configuration
JWT_SECRET=replace_this_with_a_secure_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# Security Assessment Engine Settings
SCAN_TIMEOUT_MS=15000
MAX_REDIRECTS=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
